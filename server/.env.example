PORT=4000
# Local: mongodb://127.0.0.1:27017/streamsync — Cloud: mongodb+srv URI from MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/streamsync
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_ORIGIN=http://localhost:5173
# local = serve server/media (run scripts/fetch-media.sh). remote = 302 clips to archive.org (cloud deploys)
MEDIA_MODE=local
